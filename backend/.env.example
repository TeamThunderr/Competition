# Server
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Google / Gmail
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GEMINI_API_KEYS=your_gemini_api_key_here,key2,key3
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Redis (only if switching to BullMQ later)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# pg-boss uses SUPABASE_URL — no extra config needed
DATABASE_URL=postgresql://postgres:<your_db_password>@db.<project-ref>.supabase.co:5432/postgres

# Gmail OAuth 2.0 Flow
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
FRONTEND_URL=http://localhost:5173
