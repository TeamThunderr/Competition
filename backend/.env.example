# Server
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Google / Gmail
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GEMINI_API_KEYS=your_gemini_api_key_here,key2,key3
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Redis (only if switching to BullMQ later)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# pg-boss uses SUPABASE_URL — no extra config needed
DATABASE_URL=postgresql://postgres:<your_db_password>@db.<project-ref>.supabase.co:5432/postgres

# Gmail sync queue controls
SYNC_WORKER_CONCURRENCY=2
SYNC_WORKER_MAX_CONCURRENCY=5
SYNC_WORKER_POLL_SECONDS=5
SYNC_JOB_MAX_RETRIES=3
SYNC_JOB_RETRY_LIMIT=3
SYNC_JOB_RETRY_DELAY_SECONDS=30
SYNC_JOB_EXPIRE_SECONDS=3600
SYNC_JOB_HEARTBEAT_SECONDS=30
SYNC_JOB_STALE_AFTER_MINUTES=15
GMAIL_SYNC_RATE_LIMIT_MAX=3
GMAIL_STUDENT_CHUNK_SIZE=25
GMAIL_REQUESTS_PER_MINUTE=120
GEMINI_RPM_LIMIT=14
GEMINI_BATCH_SIZE=25
GEMINI_MAX_BATCH_SIZE=50

# Gmail OAuth 2.0 Flow
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
FRONTEND_URL=http://localhost:5173
